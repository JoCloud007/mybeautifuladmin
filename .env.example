# ---- Ports exposés sur l'hôte ----
WEB_PORT=8888
API_PORT=8080

# ---- Base de données ----
POSTGRES_USER=mba
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mba

# ---- Sécurité ----
# Génère avec : openssl rand -hex 32
SECRET_KEY=
# Clé de chiffrement du coffre (mots de passe SSH, tokens API...).
# Génère avec : python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Si vide, une clé est générée automatiquement dans le volume api_keys.
VAULT_KEY=

# ---- Compte admin créé au premier démarrage ----
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_too

# ---- Collecte ----
# Intervalle de polling des hôtes, en secondes
POLL_INTERVAL=5
# Sous-réseaux proposés par défaut au scan (séparés par des virgules)
DISCOVERY_SUBNETS=192.168.1.0/24

LOG_LEVEL=INFO
TZ=Europe/Paris
